<UserControl
    x:Class="DesktopOrganizer.AppShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DesktopOrganizer.Models"
    xmlns:converters="using:DesktopOrganizer.Converters"
    xmlns:services="using:DesktopOrganizer.Services"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:SquareIconStretchConverter x:Key="SquareIconStretchConverter"/>
        <converters:SquareIconCornerRadiusConverter x:Key="SquareIconCornerRadiusConverter"/>
        <converters:SquareIconMarginConverter x:Key="SquareIconMarginConverter"/>
        <converters:EmptyCountToVisibilityConverter x:Key="EmptyCountToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:SearchMatchVisibilityConverter x:Key="SearchMatchVisibilityConverter"/>
        <converters:DeleteLabelConverter x:Key="DeleteLabelConverter"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <!-- 自定义标题栏 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 自定义标题栏：DragRegion 是唯一可拖拽区域，按钮全部在外面，保证能点 ===== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Apps"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       FontWeight="SemiBold"
                       FontSize="14"/>

            <Border x:Name="DragRegionElement" Grid.Column="1" Background="Transparent"/>

            <TextBox x:Name="SearchBox"
                     Grid.Column="1"
                     PlaceholderText="搜索"
                     Width="400"
                     HorizontalAlignment="Left"
                     Margin="16,0,0,0"
                     VerticalAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
                <Button Click="RefreshButton_Click" ToolTipService.ToolTip="重新扫描桌面">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14"/>
                        <TextBlock Text="刷新"/>
                    </StackPanel>
                </Button>
                <Button Click="AddGroupButton_Click" ToolTipService.ToolTip="新建一个空分组，可以自己拖东西进去">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14"/>
                        <TextBlock Text="新建分组"/>
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="设置">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14"/>
                        <TextBlock Text="设置"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="12" MinWidth="220">
                                <TextBlock Text="设置" FontWeight="SemiBold" FontSize="16"/>
                                <ToggleSwitch x:Name="RoundedIconsToggle"
                                              OnContent="圆角图标：开"
                                              OffContent="圆角图标：关（原生图标）"
                                              Toggled="RoundedIconsToggle_Toggled"/>
                                <Button Click="ClearCacheButton_Click" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14"/>
                                        <TextBlock Text="清除图标缓存"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== 分组卡片区域 ===== -->
        <Grid Grid.Row="1">
            <ScrollViewer Padding="16,0,16,16">
                <ItemsControl x:Name="GroupsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ItemGroup">
                        <Grid>
                            <!-- 卡片背景用主题感知的半透明画笔（透明度在 alpha 上）：
                                 窗口级亚克力已经在后面糊了一层，卡片再叠应用内亚克力是双重模糊，
                                 拖慢渲染、多吃显存。Opacity 会连图标文字一起变淡，不能用 -->
                            <Border Background="{x:Bind services:VisualSettings.CardBrush}"
                                    CornerRadius="8"/>
                            <StackPanel Spacing="12" Padding="16">

                                <!-- 分组标题栏：重命名 / 删除（系统分组不可删除） -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{x:Bind Name, Mode=TwoWay}"
                                             IsReadOnly="{x:Bind IsSystem}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontWeight="SemiBold"
                                             FontSize="16"/>

                                    <Button Grid.Column="1"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="删除分组（组内文件不会被删除，会退回未分组）"
                                            Click="DeleteGroup_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14"/>
                                            <TextBlock Text="删除"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- 图标网格：单击打开，可拖拽到其它分组；空分组也保留最小高度，方便拖东西进去 -->
                                <Grid MinHeight="72">
                                    <TextBlock Text="拖东西到这里"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind Items.Count, Converter={StaticResource EmptyCountToVisibilityConverter}}"/>
                                    <GridView ItemsSource="{x:Bind Items, Mode=OneWay}"
                                          SelectionMode="None"
                                          CanReorderItems="False"
                                          AllowDrop="True"
                                          CanDragItems="True"
                                          Tag="{x:Bind}"
                                          DragItemsStarting="ItemsGridView_DragItemsStarting"
                                          DragItemsCompleted="ItemsGridView_DragItemsCompleted"
                                          DragOver="ItemsGridView_DragOver"
                                          Drop="ItemsGridView_Drop">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="models:DesktopItem">
                                            <StackPanel Width="88" Padding="4" Spacing="4"
                                                        HorizontalAlignment="Center"
                                                        Background="Transparent"
                                                        ToolTipService.ToolTip="{x:Bind DisplayName}"
                                                        Visibility="{x:Bind DisplayName, Converter={StaticResource SearchMatchVisibilityConverter}}"
                                                        Tapped="ItemIcon_Tapped"
                                                        PointerEntered="ItemIcon_PointerEntered"
                                                        PointerExited="ItemIcon_PointerCanceled"
                                                        PointerPressed="ItemIcon_PointerPressed"
                                                        PointerReleased="ItemIcon_PointerCanceled"
                                                        PointerCanceled="ItemIcon_PointerCanceled"
                                                        PointerCaptureLost="ItemIcon_PointerCanceled">
                                                <StackPanel.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="打开" Tag="{x:Bind}" Click="ContextOpen_Click"/>
                                                        <MenuFlyoutItem Text="更改/卸载" Tag="{x:Bind}" Click="ContextUninstall_Click"
                                                                        Visibility="{x:Bind IsInstalledApp, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <MenuFlyoutItem Text="查看快捷方式位置" Tag="{x:Bind}" Click="ContextViewShortcut_Click"
                                                                        Visibility="{x:Bind IsShortcutFile, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <MenuFlyoutSeparator/>
                                                        <MenuFlyoutItem Text="{x:Bind IsShortcutFile, Converter={StaticResource DeleteLabelConverter}}"
                                                                        Tag="{x:Bind}" Click="ContextDelete_Click"/>
                                                    </MenuFlyout>
                                                </StackPanel.ContextFlyout>

                                                <!-- macOS 风格：先缩小原图再填充，所有图标按圆角开关统一裁成圆角方形；圆角关时原图完整显示不裁切不缩边。
                                                     边框线让浅色模式下圆角轮廓也看得清（浅色底上灰盒子和白图标容易糊在一起） -->
                                                <Border Width="44" Height="44"
                                                        CornerRadius="{x:Bind UseSquareIcon, Converter={StaticResource SquareIconCornerRadiusConverter}}"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <Image Source="{x:Bind Icon}"
                                                           Margin="{x:Bind UseSquareIcon, Converter={StaticResource SquareIconMarginConverter}}"
                                                           Stretch="{x:Bind UseSquareIcon, Converter={StaticResource SquareIconStretchConverter}}"/>
                                                </Border>
                                                <TextBlock Text="{x:Bind DisplayName}"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="2"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    </GridView>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- ===== 搜索结果：Spotlight 风格，所有命中条目挤在一列紧凑列表里，不用翻各分组 ===== -->
            <Border x:Name="SearchResultsPanel"
                    Visibility="Collapsed"
                    Background="{x:Bind services:VisualSettings.SearchPanelBrush}"
                    CornerRadius="8"
                    Padding="12"
                    MaxWidth="560"
                    MinWidth="360"
                    Margin="16,16,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SearchResultsHeader"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ListView x:Name="SearchResultsList"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="SearchResultsList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DesktopItem">
                                <Grid Height="36" Padding="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="20" Height="20" VerticalAlignment="Center" Source="{x:Bind Icon}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind DisplayName}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind DisplayName}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
